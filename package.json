{
  "name": "nest-microservices",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "tsx --tsconfig tsconfig.json apps/api-gateway/src/main.ts",
    "start:dev": "tsx watch --tsconfig tsconfig.json apps/api-gateway/src/main.ts",
    "start:debug": "tsx --inspect --tsconfig tsconfig.json apps/api-gateway/src/main.ts",
    "start:prod": "node dist/apps/api-gateway/src/main.js",
    "lint": "oxlint --type-aware apps/ libs/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "start:users": "tsx --tsconfig tsconfig.json apps/users/src/main.ts",
    "start:users:dev": "tsx watch --tsconfig tsconfig.json apps/users/src/main.ts",
    "start:users:prod": "node dist/apps/users/src/main.js",
    "prisma:generate": "prisma generate --config prisma/users.config.ts && prisma generate --config prisma/orders.config.ts && prisma generate --config prisma/notifications.config.ts",
    "db:seed": "tsx prisma/users/seed.ts",
    "start:orders": "tsx --tsconfig tsconfig.json apps/orders/src/main.ts",
    "start:orders:dev": "tsx watch --tsconfig tsconfig.json apps/orders/src/main.ts",
    "start:orders:prod": "node dist/apps/orders/src/main.js",
    "db:migrate:users": "prisma migrate dev --config prisma/users.config.ts",
    "db:migrate:orders": "prisma migrate dev --config prisma/orders.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma/users.config.ts && prisma migrate deploy --config prisma/orders.config.ts && prisma migrate deploy --config prisma/notifications.config.ts",
    "db:migrate:notifications": "prisma migrate dev --config prisma/notifications.config.ts",
    "rabbitmq:setup": "tsx --tsconfig tsconfig.json scripts/setup-rabbitmq.ts",
    "start:notifications": "tsx --tsconfig tsconfig.json apps/notifications/src/main.ts",
    "start:notifications:dev": "tsx watch --tsconfig tsconfig.json apps/notifications/src/main.ts",
    "start:notifications:prod": "node dist/apps/notifications/src/main.js",
    "rabbitmq:emit": "tsx --tsconfig tsconfig.json scripts/emit-order-created.ts",
    "test:messaging": "npm run build && node scripts/test-messaging.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
